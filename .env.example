# Copy to .env and fill in. .env is gitignored; .env.example is not.
#
#   cp .env.example .env && chmod 600 .env
#
# A real environment variable always wins over this file, so
# `DEEPSEEK_API_KEY=other make run-deepseek` still overrides it.
# Values are used literally: $OTHER is NOT expanded, and quotes are only needed
# when a value contains spaces or a '#'.

# ── which model provider ────────────────────────────────────────────────────
# anthropic (default) | deepseek | scripted
OBA_BACKEND=deepseek

# Needed when OBA_BACKEND=deepseek. Create one at platform.deepseek.com.
# There is no other credential source for this provider, so startup refuses
# without it.
DEEPSEEK_API_KEY=

# Needed when OBA_BACKEND=anthropic, unless `ant auth login` has been run.
# ANTHROPIC_API_KEY=

# Model ids default from OBA_BACKEND and rarely need setting. An id belonging to
# a different provider is refused at startup rather than silently remapped.
# OBA_AGENT_MODEL=deepseek-v4-pro
# OBA_CLASSIFIER_MODEL=deepseek-v4-flash

# ── how answers read ────────────────────────────────────────────────────────
# zh-CN (default) | en | match  — "match" mirrors whatever the person wrote in.
OBA_REPLY_LANGUAGE=zh-CN

# ── everything else has a working default ───────────────────────────────────
# OBA_ADDR=:8787
# OBA_STATE_PATH=.state/oba.json
# OBA_K_ANONYMITY=5
# OBA_ENABLED_INTENTS=individual_pathway,low_access_support
