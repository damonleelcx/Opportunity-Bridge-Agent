# Copy to deploy/deploy.env and fill in. deploy.env is gitignored.
#
#   cp deploy/deploy.env.example deploy/deploy.env
#
# These are account-specific identifiers, not secrets — but this repository is
# public, and naming an account, an instance and a bucket in it only narrows the
# work for somebody probing them. The scripts read them from here instead.

# EC2 instance running k3s, reached over SSM (no SSH, no open port 22).
INSTANCE=i-0123456789abcdef0
REGION=us-east-1

# Bucket used to stage the image tarball and the rendered manifests. Private.
BUCKET=your-deploy-artefacts-bucket

# AWS account id, used to scope the node IAM policy to your own secrets.
ACCOUNT_ID=000000000000

# Public hostname served by the ingress.
HOSTNAME=jobs.example.com
